{
  "name": "br-autos-api",
  "version": "1.0.0",
  "description": "BR Autos API - Retorna dados de carros do mercado brasileiro.",
  "homepage": "https://github.com/ueslialmeida/br-autos-api#readme",
  "bugs": {
    "url": "https://github.com/ueslialmeida/br-autos-api/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ueslialmeida/br-autos-api.git"
  },
  "author": "Uesli Almeida & Werner Vasconcelos",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon src/shared/http/server.ts",
    "build": "tsup src",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "lint-staged": {
    "**/*.{ts,tsx,cy.ts,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/pg": "^8.20.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^6.4.3",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^1.0.0-rc.4",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  }
}
